{
	"name": "learnharness",
	"version": "0.7.0",
	"license": "AGPL-3.0-only",
	"author": {
		"name": "Amos Blomqvist",
		"email": "255718537+amosblomqvist@users.noreply.github.com"
	},
	"homepage": "https://github.com/amosblomqvist/learnharness",
	"desktopName": "learnharness.desktop",
	"description": "An agent harness for learning: adaptive teaching, practice, and a persistent knowledge graph.",
	"type": "module",
	"private": true,
	"main": "electron/main.cjs",
	"scripts": {
		"dev": "npm run plugins:build-core && npm run plugins:build-authoring && next dev -H localhost",
		"build": "npm run plugins:build-core && npm run plugins:build-authoring && next build",
		"start": "next start -H localhost",
		"test": "NODE_ENV=test ./node_modules/.bin/tsx --test tests/*.test.ts tests/*.test.tsx",
		"test:gate": "NODE_ENV=test PEER_REQUIRE_SUBSTRATE=1 ./node_modules/.bin/tsx --test tests/*.test.ts tests/*.test.tsx",
		"test:parity": "NODE_ENV=test PEER_API_PARITY=1 ./node_modules/.bin/tsx --test tests/api-parity.test.ts",
		"test:substrate": "NODE_ENV=test PEER_REQUIRE_SUBSTRATE=1 ./node_modules/.bin/tsx --test tests/substrate-foundation.test.ts tests/substrate-native-smoke.test.ts tests/lumberjack-dag-store.test.ts tests/lumberjack-events-objects.test.ts tests/import-learnharness.test.ts tests/import-learnharness-faults.test.ts tests/mfn-unit.test.ts tests/mfn-outbox.test.ts tests/mfn-client.test.ts tests/mfn-context-mapper.test.ts tests/mfn-context-faults.test.ts tests/mfn-chat-handler.test.ts tests/mfn-live-integration.test.ts tests/mfn-live-backup-pause.test.ts",
		"client:build": "node scripts/client-build.mjs",
		"test:client:e2e": "node scripts/client-build.mjs && NODE_ENV=test PEER_E2E=1 ./node_modules/.bin/tsx --test --test-concurrency=1 tests/client-e2e-session-readonly.test.ts",
		"lint": "eslint .",
		"typecheck": "tsc --noEmit",
		"substrate:build": "node scripts/build-substrate.mjs",
		"lumberjack:addon": "node scripts/build-lumberjack-addon.mjs",
		"plugins:setup": "node scripts/setup-plugins.mjs",
		"plugins:build-authoring": "node scripts/build-plugin-authoring.mjs",
		"plugins:build-core": "node scripts/build-core-plugins.mjs",
		"desktop:dev": "concurrently -k \"npm run dev\" \"LH_DEV_URL=http://localhost:3000 electron .\"",
		"dev:fresh": "bash scripts/dev-fresh.sh",
		"desktop:dist": "rm -rf dist .next/standalone && npm run build && node scripts/smoke-provider-runtime.mjs && node scripts/build-server.mjs && node scripts/smoke-server.mjs && DEVELOPER_DIR=${DEVELOPER_DIR:-/Applications/Xcode.app/Contents/Developer} APPLE_KEYCHAIN_PROFILE=LH_NOTARY APPLE_TEAM_ID=JS6XN22HY6 electron-builder --mac --arm64"
	},
	"dependencies": {
		"@earendil-works/pi-agent-core": "1.5.2",
		"@earendil-works/pi-ai": "1.5.2",
		"@modelcontextprotocol/sdk": "1.32.1",
		"@mozilla/readability": "^0.6.0",
		"@radix-ui/react-focus-scope": "1.1.16",
		"@radix-ui/react-popper": "1.3.7",
		"@radix-ui/react-presence": "1.1.10",
		"@radix-ui/react-use-controllable-state": "^1.2.6",
		"@resvg/resvg-js": "^2.6.2",
		"@rive-app/react-webgl2": "^4.32.1",
		"@silvia-odwyer/photon-node": "0.3.4",
		"@streamdown/cjk": "^1.0.3",
		"@streamdown/code": "^1.1.1",
		"@streamdown/math": "^1.0.2",
		"@streamdown/mermaid": "^1.0.2",
		"@xyflow/react": "^12.11.3",
		"aria-hidden": "1.2.6",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"d3-force": "^3.0.0",
		"d3-selection": "^3.0.0",
		"d3-shape": "^3.2.0",
		"d3-zoom": "^3.0.0",
		"dagre-d3-es": "7.0.14",
		"electron-updater": "^6.8.9",
		"embla-carousel-react": "^8.6.0",
		"jose": "^6.2.12",
		"katex": "0.18.2",
		"linkedom": "^0.18.13",
		"lucide-react": "^1.33.0",
		"mdast-util-from-markdown": "2.0.3",
		"mdast-util-math": "3.0.0",
		"media-chrome": "^4.19.2",
		"mermaid": "^11.17.0",
		"micromark-extension-math": "3.1.0",
		"motion": "^13.1.1",
		"nanoid": "^6.0.1",
		"next": "^16.4.6",
		"next-themes": "^0.4.6",
		"pdfjs-dist": "^6.3.289",
		"puppeteer-core": "^25.8.0",
		"radix-ui": "^1.6.7",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-remove-scroll": "2.7.2",
		"remark-breaks": "^4.0.0",
		"streamdown": "^2.5.0",
		"tailwind-merge": "^3.6.0",
		"tokenlens": "^1.3.1",
		"turndown": "^7.2.4",
		"typebox": "^1.3.27",
		"undici": "^7.29.0",
		"use-stick-to-bottom": "^1.1.6",
		"zod": "^4.4.3"
	},
	"overrides": {
		"katex": "$katex"
	},
	"devDependencies": {
		"@happy-dom/global-registrator": "20.12.0",
		"@next/eslint-plugin-next": "^16.4.6",
		"@tailwindcss/postcss": "^4.3.3",
		"@types/node": "^24.0.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@types/turndown": "^5.0.6",
		"@typescript-eslint/parser": "^8.68.0",
		"concurrently": "^10.0.5",
		"electron": "^44.9.3",
		"electron-builder": "26.16.1",
		"esbuild": "0.28.2",
		"eslint": "^9.39.5",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-import": "^2.32.0",
		"happy-dom": "20.12.0",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.19.0",
		"typescript": "^5.6.0"
	}
}
